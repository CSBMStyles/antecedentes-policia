# ===========================================================================
# Este proyecto NO necesita API keys.
# El reCAPTCHA de la Policía se resuelve manualmente en Chrome.
#
# Copia este archivo como ".env" solo si quieres cambiar estos valores.
# Las rutas, la hoja y el mapeo se guardan en config.json desde la interfaz.
# ===========================================================================

# Tiempo máximo de espera del captcha manual, en segundos.
MANUAL_TIMEOUT=300

# Intentos por persona si el sitio rechaza el captcha.
CAPTCHA_MAX_ATTEMPTS=2

# Driver: auto (undetected-chromedriver con respaldo a Selenium) | uc | selenium
DRIVER_BACKEND=auto
